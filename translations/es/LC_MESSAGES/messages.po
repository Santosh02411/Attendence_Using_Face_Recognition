#: templates/student_profile.html:41
#, python-format
msgid ""
"Your attendance is %(pct)s%%, below the %(threshold)s%% threshold. If you "
"think this is wrong, check your attendance history — you can request a "
"correction there."
msgstr ""
"Tu asistencia es del %(pct)s%%, por debajo del umbral del %(threshold)s%%. "
"Si crees que es un error, consulta tu historial de asistencia — puedes "
"solicitar una corrección allí."

#: templates/student_profile.html:42
msgid "attendance history"
msgstr "historial de asistencia"

#: templates/student_profile.html:47
msgid ""
"No face photos on record — face-based attendance marking won't work until "
"you add some."
msgstr ""
"No hay fotos de rostro registradas — el marcado de asistencia por "
"reconocimiento facial no funcionará hasta que añadas algunas."

#: templates/student_profile.html:48
msgid "Add your face photos now"
msgstr "Añade tus fotos de rostro ahora"

#: templates/student_profile.html:50
#, python-format
msgid "%(count)s face photo(s) on record"
msgstr "%(count)s foto(s) de rostro registradas"

#: templates/student_profile.html:51
#, python-format
msgid "(average quality %(quality)s/100)"
msgstr "(calidad media %(quality)s/100)"

#: templates/student_profile.html:52
msgid "Manage my face photos"
msgstr "Gestionar mis fotos de rostro"

#: templates/student_profile.html:57
msgid "Your face enrollment quality is low"
msgstr "La calidad de tu inscripción facial es baja"

#: templates/student_profile.html:57
msgid "and you have fewer than 3 photos on file"
msgstr "y tienes menos de 3 fotos registradas"

#: templates/student_profile.html:58
msgid "attendance recognition may be less reliable for you. Consider"
msgstr ""
"el reconocimiento de asistencia puede ser menos fiable para ti. Considera"

#: templates/student_profile.html:59
msgid "adding more photos"
msgstr "añadir más fotos"

#: templates/student_profile.html:60
msgid "or doing a full"
msgstr "o hacer una"

#: templates/student_profile.html:60
msgid ""
"This clears all your current face photos so you can start fresh. Continue?"
msgstr ""
"Esto borrará todas tus fotos de rostro actuales para empezar de nuevo. "
"¿Continuar?"

