# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit your actual secret key or passwords.
# Every setting below is optional; the app falls back to safe/dev defaults
# for anything you don't set. See config.py for the full list and defaults.

# --- Required in any real deployment -------------------------------------
FLASK_SECRET_KEY=replace-with-a-long-random-value
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Server -----------------------------------------------------------
# FLASK_DEBUG=1               # dev only — never enable in production
# FLASK_RUN_HOST=127.0.0.1    # use 0.0.0.0 only if you mean to expose it
# FLASK_RUN_PORT=5000

# --- Reverse proxy (see README "Deploying behind a reverse proxy") -------
# BEHIND_REVERSE_PROXY=0
# PROXY_FIX_NUM_PROXIES=1
# SESSION_COOKIE_SECURE=1      # set to 1 whenever the site is actually served over HTTPS

# --- Paths (rarely need overriding) ------------------------------------
# BASE_DIR=
# DATA_DIR=
# MODELS_DIR=
# DATABASE_DIR=
# DATABASE_PATH=
# FACE_DATABASE_PATH=
# CASCADE_PATH=
# EMBEDDER_MODEL_PATH=

# --- Attendance rules ---------------------------------------------------
# LOW_ATTENDANCE_THRESHOLD_PERCENT=75
# LATE_ENTRY_ENFORCEMENT_ENABLED=0
# LATE_ENTRY_GRACE_MINUTES=10
# LATE_ENTRY_LATE_WINDOW_MINUTES=20
# LATE_COUNTS_AS_PRESENT=1
# ATTENDANCE_EDIT_LOCK_ENABLED=1
# ATTENDANCE_EDIT_LOCK_DAYS=30
# CORRECTION_REASON_MAX_LENGTH=500

# --- Face embedding match thresholds (HIGHER = stricter match) ----------
# Cosine similarity in [-1, 1] between two 128-d face embeddings.
# RECOGNIZE_MATCH_THRESHOLD=0.5
# DUPLICATE_FACE_MATCH_THRESHOLD=0.6
# MARK_ATTENDANCE_MATCH_THRESHOLD=0.55
# EMBEDDER_MODEL_VERSION=openface-nn4-small2-v1
# All five of RECOGNIZE_MATCH_THRESHOLD, MARK_ATTENDANCE_MATCH_THRESHOLD,
# DUPLICATE_FACE_MATCH_THRESHOLD, ANTI_SPOOF_MAX_PERIODICITY_RATIO, and
# IMAGE_QUALITY_MIN_LAPLACIAN_VARIANCE can also be overridden at runtime
# from /admin/recognition-settings, without editing the environment or
# restarting — a saved override there takes precedence over these.

# --- Face enrollment quality / status ------------------------------------
# ENROLLMENT_MIN_PHOTOS=3
# ENROLLMENT_QUALITY_REENROLL_THRESHOLD=50.0

# --- Haar cascade detection tuning (advanced) ---------------------------
# REGISTRATION_DETECT_SCALE_FACTOR=1.1
# REGISTRATION_DETECT_MIN_NEIGHBORS=5
# REGISTRATION_DETECT_MIN_SIZE=50
# RECOGNIZE_DETECT_SCALE_FACTOR=1.2
# RECOGNIZE_DETECT_MIN_NEIGHBORS=5
# RECOGNIZE_DETECT_MIN_SIZE=100
# MARK_ATTENDANCE_DETECT_SCALE_FACTOR=1.1
# MARK_ATTENDANCE_DETECT_MIN_NEIGHBORS=6
# MARK_ATTENDANCE_DETECT_MIN_SIZE=100
# MARK_ATTENDANCE_FALLBACK_SCALE_FACTOR=1.2
# MARK_ATTENDANCE_FALLBACK_MIN_NEIGHBORS=5
# MARK_ATTENDANCE_FALLBACK_DETECT_MIN_SIZE=80

# --- Basic liveness / anti-spoofing check (see config.py for details) ---
# LIVENESS_CHECK_ENABLED=1
# LIVENESS_FRAME_GAP_MS=350
# LIVENESS_MIN_MEAN_PIXEL_DIFF=1.5

# --- Rate limiting (Flask-Limiter, per IP) -------------------------------
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_LOGIN=10 per minute
# RATE_LIMIT_ATTENDANCE=20 per minute
# RATE_LIMIT_STORAGE_URI=memory://

# --- Account lockout (independent of rate limiting) ----------------------
# LOCKOUT_MAX_FAILED_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15

# --- Attendance-marking abuse lockout (separate from the login lockout
# above — see README "Anti-Proxy / Face Recognition Security") ------------
# ATTENDANCE_LOCKOUT_MAX_FAILED_ATTEMPTS=5
# ATTENDANCE_LOCKOUT_DURATION_MINUTES=30

# --- Security-event dashboard ---------------------------------------------
# SECURITY_ALERT_WINDOW_DAYS=7

# --- Security monitoring: fingerprinting, risk scoring, escalation -------
# SECURITY_RISK_WINDOW_DAYS=30
# SECURITY_RISK_ESCALATION_THRESHOLD=60
# CONCURRENT_SESSION_WINDOW_MINUTES=15
# NETWORK_CHANGE_WINDOW_MINUTES=60
# NETWORK_CHANGE_IMPOSSIBLE_MINUTES=5
# The three window/threshold values above (plus the five face-recognition
# thresholds listed earlier) can also be overridden at runtime from
# /admin/security-settings and /admin/recognition-settings respectively,
# without editing the environment or restarting.

# --- Observability ---------------------------------------------------------
# METRICS_ENABLED=1
# METRICS_AUTH_TOKEN=
# REALTIME_UPDATES_ENABLED=1
# REALTIME_LONGPOLL_TIMEOUT_SECONDS=8

# --- CAPTCHA (self-hosted image, no third-party service) -----------------
# CAPTCHA_ENABLED=1
# CAPTCHA_LENGTH=5

# --- Password policy -------------------------------------------------
# PASSWORD_MIN_LENGTH=8
# PASSWORD_REQUIRE_LETTER_AND_DIGIT=1

# --- Session lifetime -----------------------------------------------
# SESSION_LIFETIME_MINUTES=60

# --- Request size limits ----------------------------------------------
# MAX_CONTENT_LENGTH_MB=15
# MAX_REGISTRATION_IMAGES=20
# MAX_IMAGE_BASE64_CHARS=6000000

# --- Enhanced liveness: blink challenge ----------------------------------
# LIVENESS_FRAME_COUNT=5
# LIVENESS_REQUIRE_BLINK=1

# --- Multi-face handling -------------------------------------------------
# REJECT_MULTIPLE_FACES=1

# --- Registration image quality checks ------------------------------------
# IMAGE_QUALITY_CHECK_ENABLED=1
# IMAGE_QUALITY_MIN_LAPLACIAN_VARIANCE=40.0
# IMAGE_QUALITY_MIN_BRIGHTNESS=40.0
# IMAGE_QUALITY_MAX_BRIGHTNESS=220.0

# --- Active liveness challenge (anti-proxy — see README) ------------------
# ACTIVE_LIVENESS_ENABLED=1
# ACTIVE_LIVENESS_CHALLENGE_TYPES=blink,head_turn,head_nod
# ACTIVE_LIVENESS_CHALLENGE_TTL_SECONDS=30
# ACTIVE_LIVENESS_HEAD_TURN_MIN_SHIFT_RATIO=0.12
# ACTIVE_LIVENESS_HEAD_NOD_MIN_SHIFT_RATIO=0.10

# --- Screen/print replay ("spoof") detection — see README -----------------
# ANTI_SPOOF_ENABLED=1
# ANTI_SPOOF_MAX_PERIODICITY_RATIO=30.0

# --- Ensemble embedding matching (accuracy) --------------------------------
# MATCH_TOP_K=1

# --- Network restriction for attendance marking ("IP geofencing") --------
# Comma-separated IPs and/or CIDR ranges. Empty (default) = unrestricted.
# ATTENDANCE_ALLOWED_NETWORKS=10.0.0.0/24,192.168.1.50

# --- Session scheduling ---------------------------------------------------
# ALLOW_OVERLAPPING_SESSIONS=0
# SESSION_AUTO_CLOSE_ENABLED=1

# --- Pagination -------------------------------------------------------
# STUDENTS_PER_PAGE=25
# AUDIT_LOG_PER_PAGE=50
# ATTENDANCE_RECORDS_PER_PAGE=50

# --- Bulk student import --------------------------------------------------
# MAX_BULK_IMPORT_ROWS=500

# --- Logging (see README "Structured Logging") ---------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json               # 'json' (default) or 'plain' for local dev
# GUNICORN_LOG_FORMAT=json      # 'json' (default) or 'plain' — gunicorn.conf.py only

# --- Error alerting / crash reporting (see README "Error Alerting") ------
# Entirely opt-in — nothing is sent anywhere unless SENTRY_DSN is set.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Backups (see README "Backup & Restore") ------------------------------
# BACKUP_DIR=
# BACKUP_RETENTION_COUNT=14

# --- Base URL (used in emailed links) --------------------------------------
# APP_BASE_URL=https://attendance.example.edu

# --- Email notifications (see README "Notifications") ---------------------
# Entirely opt-in — nothing is sent unless EMAIL_NOTIFICATIONS_ENABLED=1
# AND SMTP_HOST is set.
# EMAIL_NOTIFICATIONS_ENABLED=0
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=1
# SMTP_FROM_EMAIL=no-reply@attendance.local
# SMTP_FROM_NAME=Attendance System
# SMTP_TIMEOUT_SECONDS=10

# --- SMS notifications via Twilio (see README "Notifications") ------------
# Entirely opt-in — nothing is sent unless SMS_NOTIFICATIONS_ENABLED=1
# AND all three TWILIO_* values below are set.
# SMS_NOTIFICATIONS_ENABLED=0
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Notification triggers --------------------------------------------------
# NOTIFY_ON_ATTENDANCE_MARK=1
# NOTIFY_ON_LOW_ATTENDANCE=1
# LOW_ATTENDANCE_ALERT_COOLDOWN_HOURS=24

# --- Self-service password reset (see README "Self-Service Password Reset")
# PASSWORD_RESET_ENABLED=1
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# RATE_LIMIT_PASSWORD_RESET=5 per minute

# --- SSO / Google login (see README "SSO / Institutional Login") ----------
# Entirely opt-in — off unless OAUTH_GOOGLE_ENABLED=1 AND both client
# credentials below are set. Get these from Google Cloud Console
# (OAuth 2.0 Client ID, "Web application" type); the authorized redirect
# URI must be <APP_BASE_URL>/auth/google/callback.
# OAUTH_GOOGLE_ENABLED=0
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
